<?xml version="1.0" encoding="utf-8"?>
<!-- Fără ?attr/ aici. Un drawable XML e încărcat prin Resources.loadDrawable, care
     pe calea asta primește theme=null, deci un atribut de temă aruncă
     UnsupportedOperationException la inflate ("Failed to resolve attribute at
     index 0 ... theme=null"). Versiunea precedentă folosea
     ?attr/selectableItemBackground și dobora aplicația la prima linie din listă.
     Ripple-ul cu o culoare concretă face același lucru vizual, fără temă. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item>
        <selector>
            <!-- Starea "activated" marchează imprimanta către care pleacă jobul. -->
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/selected_item" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
